<?xml version="1.0"?>
<sdf version="1.9">
  <model name="custom_x500_power">
    <!-- Keep the stock x500 flight physics and actuator path unchanged. -->
    <include merge="true"><uri>model://x500</uri></include>
    <plugin filename="ArionCoupledPowerPlugin" name="arion::CoupledPowerState">
      <!-- Flight evidence must use simulated joint feedback, never fallback. -->
      <allow_command_fallback>false</allow_command_fallback>
    </plugin>
  </model>
</sdf>
