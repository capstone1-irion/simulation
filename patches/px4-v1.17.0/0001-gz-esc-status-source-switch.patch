 bool GZMixingInterfaceESC::init(const std::string &model_name)
 {
@@ -102,6 +103,14 @@ void GZMixingInterfaceESC::Run()
 
 void GZMixingInterfaceESC::motorSpeedCallback(const gz::msgs::Actuators &actuators)
 {
+	// Status-only ownership switch. The actuator publication path is unchanged.
+	int32_t publish_status = 1;
+	const param_t status_parameter = param_find("SIM_GZ_ESC_ST");
+	if (status_parameter != PARAM_INVALID && param_get(status_parameter, &publish_status) == 0
+	    && publish_status == 0) {
+		return;
+	}
+
 	if (hrt_absolute_time() == 0) {
 		return;
 	}
@@ -123,6 +132,11 @@ void GZMixingInterfaceESC::motorSpeedCallback(const gz::msgs::Actuators &actuato
 
 	if (esc_status.esc_count > 0) {
 		esc_status.timestamp = hrt_absolute_time();
+		// A departing instance-0 publisher clears the shared advertised flag.
+		// Restore status visibility when the operator re-enables this source.
+		if (orb_exists(ORB_ID(esc_status), 0) != PX4_OK) {
+			orb_advertise(ORB_ID(esc_status), nullptr);
+		}
 		_esc_status_pub.publish(esc_status);
 	}
 
