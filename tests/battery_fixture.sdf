<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional fixture for a later authorized Gazebo run; not a flight model. -->
<sdf version="1.9">
  <world name="battery_fixture">
    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <model name="battery_fixture">
      <static>true</static>
      <link name="base_link"/>
      <plugin filename="ArionFixedBatteryPlugin" name="arion::FixedBatteryState"/>
    </model>
  </world>
</sdf>
